{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/set-state-in-effect": "off",
    "react/purity": "off"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": [".output/**", ".wxt/**", "node_modules/**"]
}
