{
  "name": "bookmark-otter",
  "version": "0.1.0",
  "private": true,
  "description": "Smart, AI-powered bookmark manager & health suite for Google Chrome",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:safari": "wxt zip -b safari",
    "compile": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.96",
    "@ai-sdk/deepseek": "^3.0.79",
    "@ai-sdk/google": "^4.0.111",
    "@ai-sdk/groq": "^4.0.76",
    "@ai-sdk/openai": "^4.0.108",
    "@ai-sdk/react": "^4.0.166",
    "@ai-sdk/xai": "^5.0.38",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@wxt-dev/i18n": "^0.2.8",
    "ai": "^7.0.162",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
